# You only need to change variables that are not commented out
# The rest is optional


# Path to the CSV export of your colles, relative to /app.
# Put your file there (or point this somewhere else, e.g. /data/colles.csv).
COLLES_CSV_PATH=input/colles.csv


# Shows the n next colles
NUMBER_OF_COLLES_TO_SHOW=1


# Set this to your instance's url,
# I recommend using https and setup either an already trusted ssl cert
# or a self signed certificate (see below)
# Default : https://ntfy.sh
# NTFY_SERVER=

# Set this to the ntfy topic you want to use for your notifictions,
# I suggest using a random string if using a public instance or the default server
NTFY_TOPIC=YourTopicName
NTFY_TITLE=Today's colles

# The format you want your message to have (see documentation)
# Available fields: matiere, colleur, salle, jour, date, heure, fin,
# and date_time (date and heure together)
# Default : {matiere} {date} {heure} {salle} {colleur}
# NTFY_FORMAT=


# ---------------------------------------------------------------------------
# Everything below is optional: it is only used when the CSV file is missing,
# in which case the script falls back to scraping your ecolle instance.
# ---------------------------------------------------------------------------

# Set this to your institution's base e-colle url
# BASE_URL=https://ecolle.example.com
# You need those to auth to ecolle and get your colle agenda
# COLLES_USERNAME=YourUsername
# COLLES_PASSWORD=YourPassword

# Where the normalised agenda is cached, so notifications can still be sent
# when the CSV cannot be read.
# Default : output/agenda.csv
# AGENDA_CSV_PATH=output/agenda.csv

# Only set to true if you are using a self signed certificate for your own instance
# Default : False
# SELF_SIGNED_CERTIFICATE=true

# Path to your rootCA that signed you ssl certificate
# ROOT_CA_PATH=/path/to/rootCA.pem
